# PHPStan 2.x configuration for pdf_oxide PHP binding.
#
# Level guidance (per SOTA-2026 report):
#   - Level 0–4: trivially passable, no real coverage
#   - Level 5–7: "decent project"
#   - Level 8: null-safety floor for new packages
#   - Level 9: strict mixed (most FFI returns touch this)
#
# We START at level 5 for v0.3.55 because the binding ships ~27 kLoC
# across 127 files with heavy raw FFI\CData usage on the Managers/
# surface — pushing straight to level 8 produces hundreds of
# unresolvable warnings without a Internal\ façade refactor.
#
# Ratchet plan (tracked for v0.3.56+):
#   1. Wrap raw FFI\CData in an Internal\ namespace marked @internal.
#   2. Once contained, ratchet level: 5 → 6 → 7 → 8.
#   3. Add a DynamicMethodReturnTypeExtension for the public wrapper
#      API to reach level 9.
#
# See php/phpstan-stubs/ffi.stub.php for hand-rolled FFI surface stubs.

parameters:
    level: 5
    paths:
        - src
        - tests
    excludePaths:
        # Generated FFI header bridge — autogenerated, not hand-edited.
        - scripts/preprocess_header.py
        # Post-install download bootstrap — runs outside the package.
        - scripts/download-native-lib.php
        # PHP scaffolding scripts only used at install/build time.
        - scripts/*
        # Vendored / generated FFI header surface (no PHP code).
        - include/*
    stubFiles:
        - phpstan-stubs/ffi.stub.php
    # FFI returns are runtime-typed; don't lie to PHPStan about them.
    treatPhpDocTypesAsCertain: false
    # Bootstrap the FFI extension symbol so PHPStan can resolve
    # FFI::* references without requiring ext-ffi at static-analysis
    # time.
    bootstrapFiles:
        - phpstan-stubs/ffi.stub.php
    ignoreErrors:
        # FFI\CData property access is dynamic by definition; PHPStan
        # cannot see the struct layout declared via FFI::cdef(). Allow
        # property access on CData without ratcheting noise.
        - identifier: property.notFound
          path: src/Managers/*
        - identifier: property.notFound
          path: src/FFI/*
